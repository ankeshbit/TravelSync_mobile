# TravelSync Mobile Environment Configuration

# Backend API URL
# - Android Emulator: http://10.0.2.2:3000/api
# - iOS Simulator / Web: http://localhost:3000/api
# - Physical Android device: http://<YOUR_PC_LAN_IP>:3000/api (e.g. http://192.168.1.100:3000/api)
# - Deployed production backend: https://your-backend.onrender.com/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# Firebase Web Client Configuration (Matches your existing TravelSync Firebase project)
# Copy these values from your web client .env or Firebase Console (Project Settings -> General -> Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Google OAuth Client IDs (Required for native mobile Google Sign-In)
# Obtain from Google Cloud Console (APIs & Services > Credentials) or Firebase Console (Authentication > Sign-in method > Google > Web SDK configuration)
# Web Client ID is required for generating ID tokens for Firebase signInWithCredential
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
