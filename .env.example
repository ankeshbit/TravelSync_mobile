# TravelSync Mobile Environment Configuration

# Backend API URL
# - iOS Simulator / Web: http://localhost:3000/api
# - Android Emulator: http://10.0.2.2:3000/api
# - Physical Mobile Device: http://<YOUR_LAN_IP>:3000/api (e.g. http://192.168.1.100:3000/api)
# - Production Backend: https://your-backend.onrender.com/api
EXPO_PUBLIC_API_URL=

# Firebase Client Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth Client IDs (Required for native mobile Google Sign-In)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Google Maps API Keys (Required for native maps in production / standalone builds)
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
